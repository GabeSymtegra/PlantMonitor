<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <FrontendProjectDir>$(MSBuildProjectDirectory)\..\frontend\</FrontendProjectDir>
    <FrontendDistDir>$(FrontendProjectDir)dist\</FrontendDistDir>
    <BackendWwwRootDir>$(MSBuildProjectDirectory)\wwwroot\</BackendWwwRootDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="libplctag" Version="1.5.2" />
    <PackageReference Include="S7NetPlus" Version="0.20.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.0" />
  </ItemGroup>

  <Target Name="PublishFrontendAssets" BeforeTargets="Build;Publish" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Message Text="Building frontend assets and syncing dist to wwwroot." Importance="high" />
    <Exec WorkingDirectory="$(FrontendProjectDir)" Command="npm run build" />
    <RemoveDir Directories="$(BackendWwwRootDir)" />
    <MakeDir Directories="$(BackendWwwRootDir)" />

    <ItemGroup>
      <FrontendDistFiles Include="$(FrontendDistDir)**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(FrontendDistFiles)"
      DestinationFiles="@(FrontendDistFiles->'$(BackendWwwRootDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="false" />
  </Target>

</Project>
